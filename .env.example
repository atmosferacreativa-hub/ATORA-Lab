# Copia este archivo a .env y completa los valores.

# Ruta local del plugin ATORA LMS. Por defecto usa el submódulo ./atora-lms
ATORA_LMS_PATH=./atora-lms

# SMTP (Gmail u otro)
ATORA_SMTP_HOST=
ATORA_SMTP_PORT=587
ATORA_SMTP_SECURE=tls
ATORA_SMTP_USER=
ATORA_SMTP_PASS=
ATORA_SMTP_FROM=
ATORA_SMTP_FROM_NAME=ATORA Lab
